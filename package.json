{
  "name": "tlt",
  "version": "0.1.0",
  "description": "The Last Tracker - Modular game tracker supporting multiple games",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "type-check": "vue-tsc --noEmit --project tsconfig.app.json",
    "test:pathfinder": "tsx scripts/pathfinder-tests/run_ootmm.ts tests_silke.jsonc"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "pako": "^2.1.0",
    "uint8array-extras": "^1.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^25.0.10",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.22.0",
    "globals": "^15.15.0",
    "prettier": "^3.4.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.6.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0",
    "vue-eslint-parser": "^9.4.3"
  }
}
