{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@packs/ootmm": ["./src/shims/ootmm-pack.d.ts"],
      "@packs/ootmm/*": ["./src/shims/ootmm-pack.d.ts"],
      "@ootmm/data": ["./OoTMM/packages/data/src/index.ts"],
      "@ootmm/data/*": ["./OoTMM/packages/data/src/*"],
      "@ootmm/core": ["./OoTMM/packages/core/lib/combo/index.ts"],
      "@ootmm/core/*": ["./OoTMM/packages/core/lib/combo/*"]
    },
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "allowJs": true,
    "jsx": "preserve",
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "packs/**/*"],
  "exclude": ["node_modules", "dist", "OoTMM/**/*"]
}
